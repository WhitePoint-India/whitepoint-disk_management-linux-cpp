#ifndef DISK_OPERATIONS_H
#define DISK_OPERATIONS_H

#include <disks>
#include <concepts>
#include <functional>

namespace DiskOperations {

    class Progress {
    private:
        unsigned long long totalBytes;
        unsigned long long bytesProcessed;
    public:
        Progress(
            unsigned long long bytesProcessed,
            unsigned long long totalBytes
        ) : totalBytes(totalBytes), bytesProcessed(bytesProcessed) {
        }

        double fractionCompleted() const {
            if (totalBytes == 0) {
                return 0;
            }
            return static_cast<double>(bytesProcessed) / static_cast<double>(totalBytes);
        }

        double percentageCompleted() const {
            return fractionCompleted() * 100;
        }
    };

    template <typename T>
    concept DiskType = std::derived_from<T, DiskManagement::Disk>;

    template <DiskType Disk, typename Stage>
    class AnyDeleteOperation {
    public:
        virtual ~AnyDeleteOperation() = default;

        using Callback = std::function<void(Stage, const Progress&)>;

        virtual void deleteDisk(Disk& disk, Callback callback) const = 0;
    };
    
    namespace NIST_800_88 {

        enum class OperationStage {
            DISK_FREEZE_CHECK,
            HPA_AVAILABILITY_CHECK,
            HPA_REMOVAL,
            DCO_AVAILABILITY_CHECK,
            DCO_REMOVAL,
            SETTING_PASSWORD,
            ERASURE,
            VERIFICATION
        };

        class Operation : public AnyDeleteOperation<DiskManagement::ATADisk, OperationStage>, public AnyDeleteOperation<DiskManagement::NVMeDisk, OperationStage> {
        public:
            void deleteDisk(DiskManagement::ATADisk& disk, AnyDeleteOperation<DiskManagement::ATADisk, OperationStage>::Callback callback) const override;
            void deleteDisk(DiskManagement::NVMeDisk& disk, AnyDeleteOperation<DiskManagement::NVMeDisk, OperationStage>::Callback callback) const override;
        };
    }

    namespace SecureErase {

